# Datos locales de la herramienta (BD, logs, catálogos)
# Se ignora todo excepto la estructura de carpetas vacías para los DATs
.rommgr/*
!.rommgr/catalogs/
.rommgr/catalogs/*
!.rommgr/catalogs/nointro/
!.rommgr/catalogs/redump/
.rommgr/catalogs/nointro/*
.rommgr/catalogs/redump/*
!.rommgr/catalogs/nointro/.gitkeep
!.rommgr/catalogs/redump/.gitkeep

__pycache__/

*.pyc
# Archivos de configuración de IDEs
.vscode/
.idea/
claude.md
# Claude Code: ignorar config local pero trackear CLAUDE.md y commands/
.claude/settings.local.json
# Archivos de configuración de sistemas operativos
.DS_Store
Thumbs.db
# Archivos de registro
*.log

# BD sueltas en la raíz (artefacto accidental — la BD real vive en .rommgr/)
/*.db


# Ignore the .env file which may contain sensitive information
.env
# User-specific config (local paths, rclone remotes)
config.toml
#log personal de tareas (en git para poder trabajar desde otro PC)
# Tareas/  ← ya no ignorado

# External binaries (place chdman.exe / adb.exe + their DLLs here locally)
tools/*
!tools/.gitkeep

# PyInstaller / Inno Setup build output (PHASE6-1a/2a) — generated, not versioned
build/
dist/
installer/output/
installer/bundled_dats/

# Android app (ANDROID-SYNC, android/) — Gradle/Android Studio local state
android/local.properties
android/.gradle/
android/app/release/
android/captures/
*.apk
*.aab
