<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Acceso recursivo en background a saves/ y states/ de RetroArch.
         API 30+: permiso especial (redirect a Ajustes). API 26-29: legacy
         storage clásico (permisos de abajo + requestLegacyExternalStorage).
         Ver Tareas/Roadmap-Android-Sync.md §3. Implementado en ANDROID-SYNC-2. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Notificación del servicio de sync instantáneo (ANDROID-SYNC-9/10).
         Runtime prompt solo en API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Servicio foreground de sync instantáneo (ANDROID-SYNC-10). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Relanzar el servicio tras reboot si el modo instantáneo estaba
         activo (ANDROID-SYNC-11). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Llamadas a la API de Dropbox + constraint de red de WorkManager. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".RetroVaultApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.RetroVaultSync">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RetroVaultSync">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AuthActivity del SDK de Dropbox (ANDROID-SYNC-5) — captura el
             redirect del navegador tras el login PKCE. El scheme
             "db-<APP_KEY>" se resuelve vía manifestPlaceholders
             (app/build.gradle.kts, léido de local.properties). Con la App
             Key vacía (sin configurar todavía) el scheme queda "db-" — no
             rompe el build, solo no captura ningún redirect real. -->
        <activity
            android:name="com.dropbox.core.android.AuthActivity"
            android:configChanges="orientation|keyboard"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="db-${dropboxAppKey}" />
            </intent-filter>
        </activity>

        <!-- SyncForegroundService y BootRestartReceiver se registran en
             ANDROID-SYNC-10/11. -->

    </application>

</manifest>
