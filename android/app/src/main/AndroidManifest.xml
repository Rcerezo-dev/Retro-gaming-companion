<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Acceso recursivo en background a saves/ y states/ de RetroArch.
         API 30+: permiso especial (redirect a Ajustes). API 26-29: legacy
         storage clásico (permisos de abajo + requestLegacyExternalStorage).
         Ver Tareas/Roadmap-Android-Sync.md §3. Implementado en ANDROID-SYNC-2. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Notificaciones (runtime prompt solo en API 33+, flujo ya en
         ANDROID-SYNC-2) — obligatoria para la notificación persistente del
         modo Instantáneo (ANDROID-SYNC-10, ver SyncForegroundService). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Modo Instantáneo (ANDROID-SYNC-9/10/11, reabierto 2026-09-25 tras
         descartarse 2026-08-18 — la app deja de ser solo complemento del
         PC): SyncForegroundService mantiene vivo el FileObserver de
         saves/states, BootRestartReceiver lo relanza tras reboot. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Llamadas a la API de Dropbox + constraint de red de WorkManager. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- FTP-PICK-2: usesCleartextTraffic habilita el HTTP plano (no HTTPS) del
         servidor local (`rommgr serve`, `PcApiClient.kt`) — solo LAN de
         confianza, mismo modelo de confianza que `allow_lan` en config.toml. -->
    <application
        android:name=".RetroVaultApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.RetroVaultSync">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RetroVaultSync">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AuthActivity del SDK de Dropbox (ANDROID-SYNC-5) — captura el
             redirect del navegador tras el login PKCE. El scheme
             "db-<APP_KEY>" se resuelve vía manifestPlaceholders
             (app/build.gradle.kts, léido de local.properties). Con la App
             Key vacía (sin configurar todavía) el scheme queda "db-" — no
             rompe el build, solo no captura ningún redirect real. -->
        <activity
            android:name="com.dropbox.core.android.AuthActivity"
            android:configChanges="orientation|keyboard"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="db-${dropboxAppKey}" />
            </intent-filter>
        </activity>

        <!-- ANDROID-SYNC-10: servicio foreground del modo Instantáneo. -->
        <service
            android:name=".sync.SyncForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- ANDROID-SYNC-11: relanza el servicio anterior tras reboot si el
             usuario lo tenía activado — exported porque BOOT_COMPLETED es un
             broadcast del sistema, no de otra app (protegido por el permiso
             RECEIVE_BOOT_COMPLETED de arriba). -->
        <receiver
            android:name=".sync.BootRestartReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
